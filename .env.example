# Runtime. Anything but development/test counts as production, including
# leaving NODE_ENV out. For local development use NODE_ENV=development.
NODE_ENV=production
PORT=3000
# Dates ("today", week starts, offer end dates) follow this timezone.
TZ=Europe/Stockholm

# Security
# Set a long random value (at least 32+ chars)
SESSION_SECRET=replace-with-a-long-random-secret

# Behind HTTPS reverse proxy (recommended online defaults)
COOKIE_SECURE=true
FORCE_HTTPS=true

# Which proxy's X-Forwarded-For / X-Forwarded-Proto to trust: a number of
# hops, false, or addresses (e.g. loopback). Empty: one hop when
# COOKIE_SECURE or FORCE_HTTPS is on, none otherwise. Only trust a proxy if
# the app can't be reached around it.
TRUST_PROXY=

# Allow iframe embedding only from specific origins (comma-separated).
# Example: EMBED_ALLOWED_ORIGINS=https://homeassistant.example.com
# Leave empty to block iframe embedding.
EMBED_ALLOWED_ORIGINS=

# First-run bootstrap account creation
AUTO_BOOTSTRAP_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
# Leave empty to auto-generate on first run (only shown in non-production logs)
DEFAULT_ADMIN_PASSWORD=

# Food deals: offers from the stores configured in the admin ("Erbjudanden")
# are fetched every 12 hours (every 3 hours on weekends). Set to false to only
# fetch when you press "Uppdatera nu".
DEALS_AUTO_REFRESH=true

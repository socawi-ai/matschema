<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Matschema</title>
    <script>
      (function () {
        let saved = null;
        try { saved = localStorage.getItem('matschema-theme'); } catch (_err) {}
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
      })();
    </script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="frontend-body">
    <%
      const shortDate = (iso) => { const [, m, d] = String(iso || '').split('-'); return d ? `${Number(d)}/${Number(m)}` : ''; };
    %>
    <main class="frontend-page">
      <header class="frontend-hero">
        <div>
          <p class="frontend-eyebrow">Måltidsplanering</p>
          <h1>Matschema <span class="app-version">v<%= appVersion %></span></h1>
          <p class="frontend-lead">Den här veckan och två veckor framåt. Tryck på en rätt för att se ingredienserna. 🏷 betyder att huvudråvaran är på erbjudande.</p>
        </div>
        <div class="actions">
          <button type="button" id="themeToggle" class="button secondary" aria-label="Byt färgtema">🌙 Mörkt läge</button>
          <a class="button secondary" href="/auth/login">Admin</a>
        </div>
      </header>

      <% if (shopping) { %>
        <!-- Prominent before the shop (Mon–Thu, plan from this week), toned down otherwise. -->
        <section class="shopping-card <%= shopping.prominent ? '' : 'shopping-quiet' %>">
          <details <%= shopping.prominent ? 'open' : '' %>>
            <summary>
              <% if (shopping.prominent) { %>
                <span class="shopping-title">🛒 Handla på <strong><%= shopping.storeName %></strong></span>
                <span class="shopping-meta">för <%= shopping.periodLabel %> · <%= shopping.dealCount %> <%= shopping.dealCount === 1 ? 'erbjudande' : 'erbjudanden' %></span>
              <% } else { %>
                <span class="shopping-title">🛒 Handlat för <%= shopping.periodLabel %> på <%= shopping.storeName %></span>
                <span class="shopping-meta"><%= shopping.dealCount %> <%= shopping.dealCount === 1 ? 'erbjudande' : 'erbjudanden' %></span>
              <% } %>
            </summary>
            <% if (!shopping.groups.length) { %>
              <p class="shopping-empty">Inga erbjudanden på planerade rätter just nu.</p>
            <% } %>
            <div class="shopping-groups">
              <% shopping.groups.forEach(function(group) { %>
                <div class="shopping-group">
                  <h3><%= group.emoji %> <%= group.label %></h3>
                  <ul>
                    <% group.deals.forEach(function(deal) { %>
                      <li>
                        <strong><%= deal.name %></strong><% if (deal.extra) { %> <span class="shopping-extra"><%= deal.extra %></span><% } %>
                        <span class="shopping-info"><%= deal.info.join(' · ') %></span>
                        <span class="shopping-meals">→ <%= deal.meals.map((m) => `${m.name} (${m.days.join(', ')})`).join(', ') %></span>
                      </li>
                    <% }) %>
                  </ul>
                </div>
              <% }) %>
            </div>
          </details>
        </section>
      <% } %>

      <section class="frontend-weeks-grid">
        <% weeks.forEach(function(week, weekIndex) { %>
          <article class="frontend-week-card <%= weekIndex === 0 ? 'frontend-week-current' : '' %>">
            <div class="frontend-week-head">
              <h2>
                Vecka <%= week.weekNumber %>
                <span class="frontend-week-range"><%= shortDate(week.entries[0].date) %>–<%= shortDate(week.entries[6].date) %></span>
              </h2>
              <% if (weekIndex === 0) { %>
                <span class="frontend-pill">Denna vecka</span>
              <% } %>
            </div>

            <ul class="frontend-day-list">
              <% week.entries.forEach(function(entry) {
                   const isToday = entry.date === today;
                   const isPlaceholder = !entry.mealId && (entry.mealName === 'Rester' || entry.mealName === 'Ej schemalagd ännu'); %>
                <li class="frontend-day-item <%= isToday ? 'frontend-day-today' : '' %>">
                  <span class="frontend-day-name">
                    <%= entry.day %>
                    <span class="frontend-day-date"><%= isToday ? 'Idag' : shortDate(entry.date) %></span>
                  </span>
                  <span class="frontend-meal-wrap">
                    <% if (entry.hasIngredients) { %>
                      <button type="button" class="frontend-meal-button" data-meal-id="<%= entry.mealId %>" title="<%= entry.isDeal ? 'Visa ingredienser och erbjudande' : 'Visa ingredienser' %>">
                        <%= entry.mealName %>
                      </button>
                    <% } else { %>
                      <span class="frontend-plain-meal <%= isPlaceholder ? 'frontend-meal-placeholder' : '' %>"><%= entry.mealName %></span>
                    <% } %>
                    <span class="frontend-meal-marks" aria-hidden="true"><%= entry.isFish ? '🐟' : '' %><%= entry.isVegetarian ? '🥕' : '' %><%= entry.isSpecial ? '⭐' : '' %><%= entry.isDeal ? '🏷' : '' %></span>
                  </span>
                </li>
              <% }) %>
            </ul>
          </article>
        <% }) %>
      </section>
    </main>

    <dialog id="ingredientsDialog" class="ingredients-dialog">
      <p class="frontend-eyebrow">Ingredienser</p>
      <h3 id="ingredientsTitle"></h3>
      <ul id="ingredientsList"></ul>
      <div id="mealDeals" hidden>
        <p class="frontend-eyebrow">🏷 Erbjudande hos <%= shopping ? shopping.storeName : '' %></p>
        <ul id="mealDealsList"></ul>
      </div>
      <form method="dialog">
        <button class="button secondary">Stäng</button>
      </form>
    </dialog>

    <script type="application/json" id="meal-data"><%- JSON.stringify(plannedMeals).replace(/</g, '\\u003c') %></script>
    <script src="/frontend.js"></script>
  </body>
</html>

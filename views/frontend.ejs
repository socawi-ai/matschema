<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Matschema</title>
    <script>
      (function () {
        let saved = null;
        try { saved = localStorage.getItem('matschema-theme'); } catch (_err) {}
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', saved || (prefersDark ? 'dark' : 'light'));
      })();
    </script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="frontend-body">
    <%
      const shortDate = (iso) => { const [, m, d] = String(iso || '').split('-'); return d ? `${Number(d)}/${Number(m)}` : ''; };
    %>
    <main class="frontend-page">
      <header class="frontend-hero">
        <div>
          <p class="frontend-eyebrow">Måltidsplanering</p>
          <h1>Matschema <span class="app-version">v<%= appVersion %></span></h1>
          <p class="frontend-lead">Den här veckan och två veckor framåt. Tryck på en rätt för att se ingredienserna.</p>
        </div>
        <div class="actions">
          <button type="button" id="themeToggle" class="button secondary" aria-label="Byt färgtema">🌙 Mörkt läge</button>
          <a class="button secondary" href="/auth/login">Admin</a>
        </div>
      </header>

      <section class="frontend-weeks-grid">
        <% weeks.forEach(function(week, weekIndex) { %>
          <article class="frontend-week-card <%= weekIndex === 0 ? 'frontend-week-current' : '' %>">
            <div class="frontend-week-head">
              <h2>
                Vecka <%= week.weekNumber %>
                <span class="frontend-week-range"><%= shortDate(week.entries[0].date) %>–<%= shortDate(week.entries[6].date) %></span>
              </h2>
              <% if (weekIndex === 0) { %>
                <span class="frontend-pill">Denna vecka</span>
              <% } %>
            </div>

            <ul class="frontend-day-list">
              <% week.entries.forEach(function(entry) {
                   const isToday = entry.date === today;
                   const isPlaceholder = !entry.mealId && (entry.mealName === 'Rester' || entry.mealName === 'Ej schemalagd ännu'); %>
                <li class="frontend-day-item <%= isToday ? 'frontend-day-today' : '' %>">
                  <span class="frontend-day-name">
                    <%= entry.day %>
                    <span class="frontend-day-date"><%= isToday ? 'Idag' : shortDate(entry.date) %></span>
                  </span>
                  <span class="frontend-meal-wrap">
                    <% if (entry.hasIngredients) { %>
                      <button type="button" class="frontend-meal-button" data-meal-id="<%= entry.mealId %>" title="Visa ingredienser">
                        <%= entry.mealName %>
                      </button>
                    <% } else { %>
                      <span class="frontend-plain-meal <%= isPlaceholder ? 'frontend-meal-placeholder' : '' %>"><%= entry.mealName %></span>
                    <% } %>
                    <span class="frontend-meal-marks" aria-hidden="true"><%= entry.isFish ? '🐟' : '' %><%= entry.isVegetarian ? '🥕' : '' %><%= entry.isSpecial ? '⭐' : '' %></span>
                  </span>
                </li>
              <% }) %>
            </ul>
          </article>
        <% }) %>
      </section>
    </main>

    <dialog id="ingredientsDialog" class="ingredients-dialog">
      <p class="frontend-eyebrow">Ingredienser</p>
      <h3 id="ingredientsTitle"></h3>
      <ul id="ingredientsList"></ul>
      <form method="dialog">
        <button class="button secondary">Stäng</button>
      </form>
    </dialog>

    <script type="application/json" id="meal-data"><%- JSON.stringify(plannedMeals).replace(/</g, '\\u003c') %></script>
    <script src="/frontend.js"></script>
  </body>
</html>

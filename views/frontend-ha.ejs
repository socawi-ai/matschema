<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Matschema HA</title>
    <script>
      (function () {
        let saved = null;
        try { saved = localStorage.getItem('matschema-theme'); } catch (_err) {}
        const theme = saved || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="frontend-body ha-body">
    <main class="ha-page">
      <% if (shopping) { %>
        <p class="ha-shopping">🛒 <%= shopping.storeName %> · <%= shopping.dealCount %> <%= shopping.dealCount === 1 ? 'erbjudande' : 'erbjudanden' %></p>
      <% } %>
      <section class="ha-week-list">
        <% weeks.forEach(function(week, weekIndex) { %>
          <article class="ha-week-row <%= weekIndex === 0 ? 'ha-week-current' : '' %>">
            <div class="ha-week-label">v<%= week.weekNumber %></div>
            <div class="ha-days-grid">
              <% week.entries.forEach(function(entry) { %>
                <div class="ha-day-cell <%= entry.date === today ? 'ha-day-today' : '' %>">
                  <div class="ha-day-name"><%= entry.day.slice(0, 3) %></div>
                  <% if (entry.hasIngredients) { %>
                    <button type="button" class="ha-meal-button" data-meal-id="<%= entry.mealId %>">
                      <%= entry.mealName %><%= entry.isDeal ? ' 🏷' : '' %>
                    </button>
                  <% } else { %>
                    <span class="ha-meal-text"><%= entry.mealName %></span>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </article>
        <% }) %>
      </section>
    </main>

    <dialog id="ingredientsDialog" class="ingredients-dialog">
      <p class="frontend-eyebrow">Ingredienser</p>
      <h3 id="ingredientsTitle"></h3>
      <ul id="ingredientsList"></ul>
      <div id="mealDeals" hidden>
        <p class="frontend-eyebrow">🏷 Erbjudande hos <%= shopping ? shopping.storeName : '' %></p>
        <ul id="mealDealsList"></ul>
      </div>
      <form method="dialog">
        <button class="button secondary">Stäng</button>
      </form>
    </dialog>

    <script>
      // Iframe-embedded dashboards stay open for days; reload periodically so
      // schedule edits and the "today" highlight don't go stale.
      setInterval(() => {
        if (!document.getElementById('ingredientsDialog').open) {
          location.reload();
        }
      }, 5 * 60 * 1000);
    </script>

    <script type="application/json" id="meal-data"><%- JSON.stringify(plannedMeals).replace(/</g, '\\u003c') %></script>
    <script src="/frontend.js"></script>
  </body>
</html>
